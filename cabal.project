packages: *
allow-newer:
    all:base,
    all:binary,
    all:bytestring,
    all:containers,
    all:ghc-bignum,
    all:template-haskell,
    all:text,
    all:time

package lua
    flags: +cross-compile
    ghc-options: 
                 -optc-mllvm 
                 -optc-wasm-enable-sjlj
                 -optc-mllvm
                 -optc-wasm-use-legacy-eh=false
                 -optc-D_WASI_EMULATED_PROCESS_CLOCKS
                 -optc-D_WASI_EMULATED_SIGNAL
                 -optc-DLUA_STUB_TMPNAM
                 -optc-DLUA_STUB_TMPFILE
                 -optc-DLUA_STUB_SYSTEM

package minimal-example
    ghc-options:
                 -optl-lwasi-emulated-process-clocks
                 -optl-lwasi-emulated-signal
                 -optl-lsetjmp

source-repository-package
    type: git
    location: https://github.com/hslua/hslua
    tag: main
    subdir: lua
    post-checkout-command: sh -c "patch -N -p1 < ../../../patches/lua-tmpfile.patch && patch -N -p1 < ../../../patches/lua-tmpnam.patch && patch -N -p1 < ../../../patches/lua-system.patch"

