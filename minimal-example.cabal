cabal-version:      2.4
name:               minimal-example
version:            0.1.0.0
license:            NONE
author:             Kacey
maintainer:         23713192+kamelkace@users.noreply.github.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md
common warnings
